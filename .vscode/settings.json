{
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Prettier",
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "editor.quickSuggestions": {
        "strings": "on"
    },
    "tailwindCSS.classFunctions": [
        "cva",
        "tv",
        "cn"
    ]
}